.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #0e1116;
  color: #e6edf3;
  font-size: 28rpx;
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background-color: #3d1d1d;
  color: #ffb3b3;
  font-size: 24rpx;
  line-height: 1.45;
}

.link {
  margin-left: 20rpx;
  color: #6ee7b7;
}

.offline-note {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background-color: #2d2616;
  color: #e3b341;
  font-size: 24rpx;
  line-height: 1.45;
}

.section {
  margin-bottom: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background-color: #161b22;
}

.section-title {
  padding: 20rpx 0 12rpx;
  color: #8b949e;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.row {
  padding: 20rpx 0;
  border-top: 1rpx solid #21262d;
}

.row:first-child {
  border-top: none;
}

.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-label {
  font-size: 28rpx;
  color: #e6edf3;
}

.row-value {
  color: #6ee7b7;
  font-size: 28rpx;
}

/* switch садится в одну строку с подписью */
.row > switch {
  display: block;
  margin-left: auto;
}

.reading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.press {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background-color: #1b232d;
  border: 1rpx solid #30363d;
  color: #e6edf3;
  font-size: 28rpx;
}

.press:disabled {
  opacity: 0.45;
}

.picker-value {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background-color: #0d1117;
  border: 1rpx solid #30363d;
  color: #e6edf3;
  font-size: 28rpx;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #8b949e;
  font-size: 26rpx;
  line-height: 1.6;
}
