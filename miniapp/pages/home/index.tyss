.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #0e1116;
  color: #e6edf3;
  font-size: 28rpx;
}

/* ---------- первый запуск ---------- */

.setup {
  padding: 32rpx;
  border-radius: 24rpx;
  background-color: #161b22;
}

.setup-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.setup-hint {
  color: #8b949e;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  color: #8b949e;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.field-input {
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background-color: #0d1117;
  border: 1rpx solid #30363d;
  color: #e6edf3;
  font-size: 28rpx;
}

.setup-error {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background-color: #3d1d1d;
  color: #ffb3b3;
  font-size: 24rpx;
  line-height: 1.4;
}

.primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background-color: #238636;
  color: #ffffff;
  font-size: 30rpx;
  border: none;
}

/* ---------- список ---------- */

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #8b949e;
}

.toolbar-actions {
  display: flex;
  align-items: center;
}

.badge {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background-color: #1f6feb33;
  color: #79c0ff;
  font-size: 20rpx;
}

.link {
  margin-left: 24rpx;
  color: #6ee7b7;
}

.link.muted {
  color: #8b949e;
}

.banner {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background-color: #3d1d1d;
  color: #ffb3b3;
  font-size: 24rpx;
  line-height: 1.45;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #8b949e;
  font-size: 26rpx;
  line-height: 1.6;
}

.list {
  display: flex;
  flex-direction: column;
}

.card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background-color: #161b22;
}

.card-glyph {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  background-color: #0d1117;
  text-align: center;
  line-height: 72rpx;
  font-size: 36rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-name {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #e6edf3;
}

.dot-off {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background-color: #30363d;
  color: #8b949e;
  font-size: 20rpx;
}

.card-summary {
  margin-top: 6rpx;
  color: #8b949e;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chevron {
  margin-left: 12rpx;
  color: #484f58;
  font-size: 36rpx;
}
