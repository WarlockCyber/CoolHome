# Скопируйте в .env и заполните своими значениями.
# Приложение читает переменные окружения, .env само по себе не загружается.

# Адрес прослушивания. По умолчанию 127.0.0.1:8080 (только локально).
COOLHOME_ADDR=127.0.0.1:8080

# Демо-режим: фейковые устройства, Tuya не вызывается.
COOLHOME_DEMO=false

# Необязательный токен: если задан, все /api/* требуют
# Authorization: Bearer <токен> или X-Auth-Token.
COOLHOME_AUTH_TOKEN=

# Период опроса облака.
COOLHOME_POLL_INTERVAL=10s

# Необязательно: ограничить дом конкретными device_id через запятую.
COOLHOME_DEVICE_IDS=

# Необязательно: CORS-политика для браузерных клиентов (например, Tuya MiniApp
# в webview). Список origin через запятую, только схема+хост+порт, без путей.
# Пусто — CORS выключен. "*" открывает API любой странице: только с токеном
# и осознанно.
COOLHOME_ALLOWED_ORIGINS=

# Инфракрасные пульты: remote'ы, сохранённые на ИК-пульте (категория wnykq),
# показываются как устройства, у которых функции — кнопки. Требует подписки на
# сервис IR Control в консоли Tuya (Cloud -> Development -> проект -> Service API).
# Без подписки приложение работает как обычно и пишет одно предупреждение.
COOLHOME_IR=false

# Необязательно: device_id ИК-пультов через запятую. Пусто — найти автоматически.
COOLHOME_IR_BLASTERS=

# Tap-to-run сцены как устройства с кнопкой. Это единственный облачный способ
# выполнить действие, которое data-point API не умеет: например, нажать
# выученную RF-кнопку — сцену исполняет облако Туи.
COOLHOME_SCENES=false

# Необязательно: id дома (space), к которому привязаны устройства. Пусто — найти
# автоматически через /v2.0/cloud/thing/{id}.
COOLHOME_SPACE_ID=

# Файл с раскладкой пульта: какие контролы показывать на главном экране.
# Раскладка живёт на сервере, а не в браузере: планшет на стене рано или поздно
# потеряет localStorage, а файл — нет. Пусто — раскладка только в памяти
# (изменения не переживут перезапуск, UI об этом предупредит).
COOLHOME_DASHBOARD_FILE=./dashboard.json

# --- Tuya IoT Platform (iot.tuya.com -> Cloud -> Development -> ваш проект) ---
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=

# Дата-центр вашего аккаунта: cn | us | ueaz | eu | weaz | in | sg
TUYA_REGION=eu

# Необязательно: переопределить endpoint (например, при проксировании).
TUYA_BASE_URL=

# Правила «условие → действие». Движок выключен, пока не задан файл (или
# COOLHOME_RULES=true): автоматика, отправляющая команды в настоящий дом, должна
# быть включена осознанно. Интервал по умолчанию равен периоду опроса.
# COOLHOME_RULES_FILE=./rules.json
# COOLHOME_RULES_INTERVAL=10s

# Часовой пояс, в котором читается расписание правил (имя зоны IANA).
# По умолчанию — зона машины.
# COOLHOME_TZ=Europe/Moscow

# Необязательно: адрес консоли Tuya, на который ведёт ссылка в сообщениях об
# ошибках, требующих действий в консоли (квота управляемых устройств,
# неподписанный сервис). По умолчанию https://iot.tuya.com/cloud; принимаются
# только http и https.
COOLHOME_CONSOLE_URL=https://iot.tuya.com/cloud

# Необязательно: uid аккаунта приложения (Smart Life / Tuya Smart), привязанного
# к проекту. Это не uid владельца Cloud-проекта из ответа на токен. Если пусто,
# клиент сам найдёт привязанный аккаунт при ошибке 1106. Если задан — используется
# как есть, без автоподбора.
TUYA_UID=
